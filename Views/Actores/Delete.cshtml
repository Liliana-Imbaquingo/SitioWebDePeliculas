@model SitioWebDePeliculas.Models.Actor

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>
<h4>Actor</h4>

<h3>¿Está seguro de eliminar este actor?</h3>
<div>
    
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Biografia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Biografia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaNacimiento)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaNacimiento)
        </dd>
        <dt class="col-sm-2">
            <p>Películas</p>
        </dt>
        <dd class="col-sm-10">
            @if (Model.PeliculaActores != null && Model.PeliculaActores.Any())
            {
                <ul>
                    @foreach (var pa in Model.PeliculaActores)
                    {
                        <li>
                            @pa.Pelicula?.Titulo
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>Este actor aún no tiene películas registradas.</p>
            }

        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Ir a Lista de Actores</a>
    </form>
</div>
