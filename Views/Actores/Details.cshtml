@model SitioWebDePeliculas.Models.Actor

@{
    ViewData["Title"] = "Detalle del actor";
}

<h1>Detalle</h1>

<div>
    <h4>Actor</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Biografia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Biografia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaNacimiento)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaNacimiento)
        </dd>
        <dt class="col-sm-2">
            <p>Películas</p>
        </dt>
        <dd class="col-sm-10">
            @if (Model.PeliculaActores != null && Model.PeliculaActores.Any())
            {
                <ul>
                    @foreach (var pa in Model.PeliculaActores)
                    {
                        <li>
                            <a asp-controller="Peliculas" asp-action="Details" asp-route-id="@pa.Pelicula.Id">
                                @pa.Pelicula.Titulo
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>Este actor aún no tiene películas registradas.</p>
            }

        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Ir a Lista de Actores</a>
</div>
