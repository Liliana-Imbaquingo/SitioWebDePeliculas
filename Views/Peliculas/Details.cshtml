@model SitioWebDePeliculas.Models.Pelicula

@{
    ViewData["Title"] = "Details";
}

<h1>Detalle</h1>

<div>
    <h4>Película</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Sinopsis)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Sinopsis)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Duracion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Duracion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaEstreno)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaEstreno)
        </dd>
        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Genero)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Genero != null)
            {
                <a class="text-decoration-none  " asp-controller="Generos" asp-action="Details" asp-route-id="@Model.Genero.Id">@Model.Genero.Nombre </a>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Director)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Director != null)
            {
                <a class="text-decoration-none" asp-controller="Directores" asp-action="Details" asp-route-id="@Model.Director.Id">@Model.Director.Nombre </a>
            }
        </dd>
        <dt class="col-sm-2">
            <div>
                <p>Póster</p>
            </div>
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImagenRuta))
            {
                <div class="form-group">
                    
                    <img src="@Model.ImagenRuta" alt="Póster actual" style="width:100px;height:auto" />
                </div>
            }
        </dd>
        <dt class="col-sm-2">
            <div>
                <p>Actores</p>
            </div>
        </dt>
        <dd class="col-sm-10">
            @if (Model.PeliculaActores != null && Model.PeliculaActores.Any())
            {
                <ul>
                    @foreach (var pa in Model.PeliculaActores)
                    {
                       <li>
                            <a class="text-decoration-none" asp-controller="Actores" asp-action="Details" asp-route-id="@pa.Actor.Id">
                            @pa.Actor.Nombre
                            </a>
                        </li>
                    }       
                </ul>
            }
            else
            {
                <p>No hay actores registrados para esta película.</p>
            }
        </dd>
    </dl>
</div>


<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Ir a Lista de Películas</a>
</div>
