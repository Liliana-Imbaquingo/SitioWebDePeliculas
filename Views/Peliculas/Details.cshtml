@model SitioWebDePeliculas.Models.Pelicula

@{
    ViewData["Title"] = "Details";
}

<h1>Detalle</h1>

<div>
    <h4>Película</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Sinopsis)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Sinopsis)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Duracion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Duracion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaEstreno)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaEstreno)
        </dd>
        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Genero)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Genero != null) { @Model.Genero.Nombre }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Director)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Director != null) { @Model.Director.Nombre }
        </dd>
        <dt class="col-sm-2">
            <div>
                <p>Póster</p>
            </div>
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImagenRuta))
            {
                <div class="form-group">
                    
                    <img src="@Model.ImagenRuta" alt="Póster actual" style="width:100px;height:auto" />
                </div>
            }
        </dd>
        <dt class="col-sm-2">
            <div>
                <p>Actores</p>
            </div>
        </dt>
        <dd class="col-sm-10">
            @if (Model.PeliculaActores != null && Model.PeliculaActores.Any())
            {
                
                    @foreach (var pa in Model.PeliculaActores)
                    {
                        <p>@pa.Actor.Nombre</p>
                    }
                
            }
            else
            {
                <p>No hay actores registrados para esta película.</p>
            }
        </dd>
    </dl>
</div>


<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
