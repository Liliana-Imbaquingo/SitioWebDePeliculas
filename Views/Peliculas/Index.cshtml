@model IEnumerable<SitioWebDePeliculas.Models.Pelicula>
@using Microsoft.AspNetCore.Mvc.Rendering;
@{
    ViewData["Title"] = "Index";
    var generos = ViewData["Generos"] as SelectList;
    var currentGenero = ViewData["CurrentGenero"] as int?;
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<h1>Películas</h1>

<form asp-action="Index" method="get" class="mb-3 row g-2 align-items-end">
    <div class="col-auto">
        <input type="text" name="searchString" value="@currentFilter" class="form-control" placeholder="Buscar por título..." />
    </div>
    <div class="col-auto">
        <select name="generoId" class="form-select">
            <option value="">Todos los géneros</option>
            @if (generos != null)
            {
                foreach (var genero in generos)
                {
                    if (currentGenero != null && (int)currentGenero == int.Parse(genero.Value))
                    {
                        <option value="@genero.Value" selected>@genero.Text</option>
                    }
                    else
                    {
                        <option value="@genero.Value">@genero.Text</option>
                    }
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<p>
    <a asp-action="Create">Nueva Película</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagenRuta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sinopsis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Duracion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaEstreno)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Genero)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Director)
            </th>
            
            <th>Actores</th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Titulo)
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.ImagenRuta))
                {
                    <img src="@item.ImagenRuta" alt="Póster" style="width:100px;height:auto;" />
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sinopsis)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Duracion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaEstreno)
            </td>
            
            <td>
                @if (item.Genero != null)
                {
                    <a class="text-decoration-none  " asp-controller="Generos" asp-action="Details" asp-route-id="@item.Genero.Id">@item.Genero.Nombre</a>
                }
            </td>
            <td>
                @if (item.Director != null)
                {
                     <a class="text-decoration-none  " asp-controller="Directores" asp-action="Details" asp-route-id="@item.Director.Id">@item.Director.Nombre</a>
                }
            </td>
                <td>
                    @if (item.PeliculaActores != null && item.PeliculaActores.Any())
                    {
                        @foreach (var pa in item.PeliculaActores)
                        {
                            <a class="text-decoration-none" asp-controller="Actores" asp-action="Details" asp-route-id="@pa.ActorId">
                                @pa.Actor.Nombre
                            </a>

                            @if (pa != item.PeliculaActores.Last())
                            {
                                @:,&nbsp;
                            }
                        }

                    }
                    else
                    {
                        <span>No registrado</span>
                    }
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalle</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
